+/// Decide what a zero-result page means: a confirmed no-results page yields an
+/// empty list; anything else (bot challenge, markup change, empty shell) is a
+/// hard error so callers never mistake a failed fetch for "nothing found".
+fn classify_zero_result_page(document: &Html) -> SearchResult<Vec<SearchResultType>> {
+    // The explicit no-results marker DuckDuckGo renders on genuine misses.
+    let no_results_selector = Selector::parse(".result--no-results, .no-results")
+        .map_err(|_| SearchError::ParseError("Invalid CSS selector for no-results".to_string()))?;
+    if document.select(&no_results_selector).next().is_some() {
+        return Ok(Vec::new());
+    }
+
+    let page_text: String = document.root_element().text().collect::<String>().to_lowercase();
+    if page_text.contains("no results") {
+        return Ok(Vec::new());
+    }
+    // DuckDuckGo anomaly / bot-challenge pages ("Unfortunately, bots use
+    // DuckDuckGo too", captcha challenges).
+    if page_text.contains("anomaly")
+        || page_text.contains("captcha")
+        || page_text.contains("challenge")
+        || page_text.contains("bots use duckduckgo")
+    {
+        return Err(SearchError::ParseError(
+            "duckduckgo returned a bot challenge (captcha) page; search was blocked".to_string(),
+        ));
+    }
+    Err(SearchError::ParseError(
+        "duckduckgo returned an unrecognized page (markup change or empty response); \
+         refusing to report zero results for a possibly broken fetch"
+            .to_string(),
+    ))
+}
