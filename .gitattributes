*.gguf filter=lfs diff=lfs merge=lfs -text
*.gguf.input filter=lfs diff=lfs merge=lfs -text
*.gguf.output filter=lfs diff=lfs merge=lfs -text
*.png !text !filter !merge !diff
*.jpg !text !filter !merge !diff
*.mp3 !text !filter !merge !diff
*.wav !text !filter !merge !diff
*.bin !text !filter !merge !diff
*.dll !text !filter !merge !diff
*.so !text !filter !merge !diff
*.dylib !text !filter !merge !diff

# SQL migrations are byte-checksummed by sqlx::migrate!() at compile time.
# Force LF on every platform so CRLF <-> LF drift cannot desync the stored
# checksum and abort slab-server startup with a VersionMismatch error.
*.sql text eol=lf
