{
  "name": "@slab/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "bunx husky install",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:update": "vitest run --config vitest.browser.config.ts -u",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "catalog:",
    "@slab/api": "workspace:*",
    "@slab/components": "workspace:*",
    "@slab/core": "workspace:*",
    "@slab/i18n": "workspace:*",
    "@slab/plugin-sdk": "workspace:*",
    "@slab/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/markdown-it": "catalog:",
    "ai": "catalog:",
    "react": "catalog:",
    "react-arborist": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "sonner": "catalog:",
    "vscode": "catalog:"
  },
  "devDependencies": {
    "@slab/test-utils": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "catalog:",
    "import-meta-resolve": "catalog:",
    "postcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": {
    "production": [
      "safari >= 16",
      "ios_saf >= 16",
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "Firefox ESR"
    ],
    "development": [
      "last 1 safari version",
      "last 1 chrome version"
    ]
  },
  "license": "AGPL-3.0-only"
}
