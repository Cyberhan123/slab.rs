# Copy to `.env.local` and adjust for your environment.
# Direct API base (used at build time by packages/api/src/config.ts):
# VITE_API_BASE_URL=http://127.0.0.1:3000
#
# Alternative: proxy /v1 through the vite dev server instead of pointing the
# client at the API origin directly:
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000
