{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@slab/api": ["../api/src/index.ts"],
      "@slab/api/*": ["../api/src/*"]
    },
    "types": ["node"],
    "noUnusedLocals": true,
